{
  "version": "0.2.0",
  "configurations": [

    {
      "name": ".NET Core Launch (Api.Application)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Api.Application/bin/Debug/netcoreapp3.1/application.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Api.Application",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DB_CONNECTION": "Server=localhost;Port=3306;Database=CourseApi3;Uid=root;Pwd=DevSysth2025@;",
        "DATABASE": "MYSQL",
        "MIGRATION": "APLICAR"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/src/Api.Application/Views"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5000/swagger"
      }
    }
  ]
}
