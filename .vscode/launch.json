{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (Api.Application)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/Api.Application/bin/Debug/netcoreapp3.1/application.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Api.Application",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DB_CONNECTION": "Server=localhost;Port=3306;Database=CourseApi3;Uid=root;Pwd=DevSysth2025@;",
        "DATABASE": "MYSQL",
        "MIGRATION": "APLICAR"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5000/swagger"
      }
    },
    {
      "name": "Debug Testes (xUnit - Api.Data.Test)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-tests",
      "program": "${workspaceFolder}/src/Api.Data.Test/bin/Debug/netcoreapp3.1/Api.Data.Test.dll",
      "cwd": "${workspaceFolder}/src/Api.Data.Test",
      "stopAtEntry": false,
      "env": {
        "DB_CONNECTION": "Server=localhost;Port=3306;Database=CourseApi3Test;Uid=root;Pwd=DevSysth2025@;",
        "DATABASE": "MYSQL"
      },
      "console": "internalConsole"
    },
    {
      "name": "Debug Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/src/Api.Data.Test/Api.Data.Test.csproj",
        "--no-build",
        "--logger:trx",
        "--results-directory", "${workspaceFolder}/TestResults"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
