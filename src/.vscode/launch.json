{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Api.Application/bin/Debug/netcoreapp3.1/application.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Api.Application",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Api.Application/Views"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5000/weatherforecast"
      }
    }
  ]
}